{
  "name": "local-app-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "Community-curated per-country catalog of local apps, for VPN split-tunneling.",
  "license": "MIT",
  "type": "module",
  "author": "LocalAppCatalog contributors",
  "homepage": "https://github.com/localappcatalog/local-app-catalog#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/localappcatalog/local-app-catalog.git"
  },
  "bugs": {
    "url": "https://github.com/localappcatalog/local-app-catalog/issues"
  },
  "keywords": [
    "vpn",
    "split-tunneling",
    "split-tunnel",
    "local-apps",
    "app-catalog",
    "open-data",
    "odbl"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "data/",
    "tools/lib/",
    "README.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSE-DATA"
  ],
  "scripts": {
    "validate": "node tools/validate/cli.mjs",
    "validate:stores": "node tools/validate/cli.mjs --check-stores",
    "build": "node tools/build/cli.mjs",
    "curate": "node tools/curate/server.mjs",
    "curate:cli": "node tools/curate/cli.mjs",
    "recheck": "node tools/recheck/cli.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}

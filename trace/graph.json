    },
    {
      "id": "92bad6bc-db54-482d-807e-3aefe3582b6b",
      "title": "Release publishing pipeline",
      "body": "Tag vYYYY.MM.DD, publish checksummed catalog-all.json plus per-country bundles, document pinning.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    },
    {
      "id": "bd40342f-4b54-4f15-a8f0-2cc05e38ba2a",
      "title": "Store adapters + availability CLI",
      "body": "fetch/store_adapters/ one interface for Google Play, Cafe Bazaar, RuStore, AppGallery, APKPure, OneStore, Myket, F-Droid. fetch/play_availability.py is the single source of truth for availability.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    },
    {
      "id": "dcf08108-8c30-4425-914a-df9994886819",
      "title": "Tests including the confusable false-positive gate",
      "body": "node --test suite proving zero false positives on Google Wallet, PayPal, Telegram, WhatsApp, MiniChat, Amazon and the validator catches every rule violation.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    },
    {
      "id": "e2ee9280-9846-42b3-bb8e-29c13a48f4ef",
      "title": "License and README consumption contract",
      "body": "ODbL for data, MIT for tooling, README documenting the fetch-a-pinned-release contract and per-country bundle format.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    },
    {
      "id": "f39bf1df-0d0b-4449-b0bf-9a1f9c6dc5dd",
      "title": "Curation UI / PR workflow",
      "body": "tools/curate/: local web UI to add, review and export catalog entries as a ready-to-open PR diff.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    },
    {
      "id": "f454ad91-e677-447b-bf3b-753f69268dd8",
      "title": "Schema, country/category index, negative global catalog",
      "body": "data/schema.json (draft 2020-12 bundle), data/index.json registry, data/global.json negative catalog of 20 worldwide packages driving the GLOBAL_CONFLICT rule.",
      "goal_id": "dd86a2ed-469b-49de-8291-26524170319e"
    }
  ],
  "decisions": [
    {
      "id": "13499674-b965-47d1-bc3c-5c633eb9c76b",
      "title": "Global apps are modelled as a negative catalog, not as a positive allowlist",
      "body": "A positive allowlist cannot enumerate every global app and would silently miss new ones. data/global.json lists 20 worldwide packages and the validator raises GLOBAL_CONFLICT if any country file contains one, so a popular global app can never be marked local by mistake; discovery drops those packages before a reviewer ever sees them."
    },
    {
      "id": "1b2d57b0-d65e-4f69-8fc0-d14f067e5e8f",
      "title": "Availability is not locality: only country-scoped stores may promote an entry to verified",
      "body": "Measured: Google Play detail pages return 200 regardless of the gl= parameter (Telegram, WhatsApp, Google Wallet and TikTok all 200 at gl=IR), so Play, AppGallery, APKPure and F-Droid prove that a package merely exists, never that it belongs to a country. Only Cafe Bazaar, Myket and RuStore are country-scoped, so only they may promote community -\u003e verified. Consequence: a Play detail 404 is a positive signal that an app is store-isolated (genuinely local) rather than a negative one."
    },
    {
      "id": "59f8ebbd-ec3c-41f2-a6f7-e1996e6a30e2",
      "title": "Store availability logic lives in one Python implementation; the Node validator shells out",
      "body": "The adapters already exist in Python and the heuristics (soft-404 guards, per-store URL shapes, authoritative flags) are subtle. Duplicating them in Node would drift, so tools/validate/cli.mjs calls fetch/play_availability.py --json and consumes its status codes instead of reimplementing store probing."
    },
    {
      "id": "f58c1d6f-3822-4b69-8558-b99f13067ae5",
      "title": "Google Play search is the discovery source because it is country-gated",
      "body": "Measured: GET /store/search?q=\u003cq\u003e\u0026c=apps\u0026gl=\u003cCC\u003e\u0026hl=en returns locale-specific results (bank queries in Cyrillic, Turkish and Arabic return different apps per country), whereas detail pages are not gated. Discovery therefore uses Play search as a nomination channel only; every nomination still needs a curator plus, where possible, a country-scoped store confirmation."
    }
  ],
